# Populate locally. Never commit credentials.
APP_ORIGIN=https://dinkvision.vercel.app
# R2 test commands explicitly read .local/r2-test.env; keep production credentials separate.
RECORDING_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Stable server-only signing key (32 random bytes, base64).
REPLAY_SIGNING_KEY=
# Player-reachable origin. During local testing use the PC's private LAN address.
REPLAY_ORIGIN=
# Server-side email delivery. SMTP_FROM accepts a mailbox or Display Name <mailbox>.
# Use the SMTP provider's TLS settings (465/true or 587/false are typical).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_CA_CERT_PATH=
