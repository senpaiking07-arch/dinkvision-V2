VENUE_TIME_ZONE=
# Required by the local R2 tooling. Keep the value stable for existing local environments.
TOKEN_ENCRYPTION_KEY=
# Server-only random secret for /api/jobs/browser. Also set in Vercel.
CRON_SECRET=

# Android release policy. Publish and verify the approved APK first, preserving
# its package ID/signing key so installing it retains enrollment and local video.
# Example site path: https://your-app.example/downloads/Dink-Vision-Recorder-0.5.39.apk
ANDROID_APK_DOWNLOAD_URL=
# Enabling this gates older native recorder versions. Keep false until the URL works.
ANDROID_REQUIRE_LATEST=false
